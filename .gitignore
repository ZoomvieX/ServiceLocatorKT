# This .gitignore file should be placed at the root of your Unity project
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can be avoided in the future by enabling
# "Compress Textures/Mesh on Import" in Player Settings for Android and iOS
/[Mm]emoryCaptures/

# Recordings can be avoided in the future by enabling
# "Record mode" in the Video Profiler window (Unity 2020.2 and newer)
/[Rr]ecordings/

# Rexxie / Plastic SCM
/[Aa]ssets/PlasticSCM*

# Uncomment this line if you wish to ignore the asset store downloaded path
# /[Aa]ssets/AssetStoreTools*

# Autogenerated VS/Rider/JetBrains/etc. solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.filetype
*.pidb
*.booprof
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated data (see https://docs.fabric.io/crashlytics/android/terms-of-writing-buffers.html)
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*/

# Crash Reporter
/[Aa]ssets/[Aa]ppCenter*/

# Visual Studio Code / JetBrains Rider / Cursor / etc.
.vs/
.vscode/
.idea/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Rider
*.swp
*.swo